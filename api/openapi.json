{
  "openapi": "3.1.0",
  "info": {
    "title": "UniCloud Portal API",
    "version": "1.0.0",
    "summary": "Single sign-on, the directory and the staging tools for UniCloud modules.",
    "description": "The APIs a UniCloud module calls. The OpenID Connect browser flow (`/oauth2/authorize`, `/connect/logout`) is described by the discovery document and by [docs/sso.md](https://github.com/Alex-Tsvetanov/unicloud-portal/blob/main/docs/sso.md); every OIDC library reads it.\n\n**Try it out:** register a module with the directory grant on the staging page (`/staging`), press **Authorize**, choose `directoryToken` and enter the client id and secret. Swagger UI then gets a client-credentials token for you.\n\nUnknown values mean no access: `role` and `permissions` may gain new values. Treat a value you do not know as no access."
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "SSO", "description": "OpenID Connect endpoints a module's backend calls" },
    { "name": "Directory", "description": "Read who is who with no user present. Needs a client-credentials token with the `directory` scope" },
    { "name": "Staging tools", "description": "Only on staging and development. In production these routes answer 404. No sign-in needed; every team shares the data" },
    { "name": "Operations", "description": "Health and replica identity" }
  ],
  "paths": {
    "/.well-known/openid-configuration": {
      "get": {
        "tags": ["SSO"],
        "summary": "Discovery document",
        "operationId": "discovery",
        "responses": {
          "200": {
            "description": "Endpoints and capabilities. `issuer` is the exact value of `iss` in every token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Discovery" } } }
          }
        }
      }
    },
    "/oauth2/jwks": {
      "get": {
        "tags": ["SSO"],
        "summary": "Public signing keys",
        "description": "Cache the keys. Fetch them again when a token has a `kid` you do not know.",
        "operationId": "jwks",
        "responses": {
          "200": { "description": "The key set", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Jwks" } } } }
        }
      }
    },
    "/oauth2/token": {
      "post": {
        "tags": ["SSO"],
        "summary": "Exchange a code, or get a directory token",
        "description": "Client authentication is HTTP Basic only (`client_secret_basic`).\n\n- `authorization_code`: exchanges the code from the callback. The code works once and for 60 seconds. A second exchange fails and revokes what the first one issued.\n- `client_credentials`: a token for the directory API. The module must hold the `directory` grant.",
        "operationId": "token",
        "security": [{ "clientBasic": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/AuthorizationCodeGrant" },
                  { "$ref": "#/components/schemas/ClientCredentialsGrant" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens. `Cache-Control: no-store`. There is never a refresh token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } }
          },
          "400": {
            "description": "`invalid_grant` (bad, used or expired code, wrong `redirect_uri` or verifier, disabled user), `invalid_scope`, `invalid_request` or `unsupported_grant_type`",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthError" } } }
          },
          "401": {
            "description": "`invalid_client`: unknown client, wrong secret, or credentials not sent by HTTP Basic",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthError" } } }
          }
        }
      }
    },
    "/userinfo": {
      "get": {
        "tags": ["SSO"],
        "summary": "The signed-in user's claims",
        "description": "Takes the access token from an authorization-code exchange. Claims are read from the database now, for the scopes granted at login.",
        "operationId": "userinfo",
        "security": [{ "userAccessToken": [] }],
        "responses": {
          "200": { "description": "Claims", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Claims" } } } },
          "401": { "$ref": "#/components/responses/InvalidToken" }
        }
      },
      "post": {
        "tags": ["SSO"],
        "summary": "The signed-in user's claims (POST)",
        "operationId": "userinfoPost",
        "security": [{ "userAccessToken": [] }],
        "responses": {
          "200": { "description": "Claims", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Claims" } } } },
          "401": { "$ref": "#/components/responses/InvalidToken" }
        }
      }
    },
    "/api/v1/directory/users/{sub}": {
      "get": {
        "tags": ["Directory"],
        "summary": "A user",
        "operationId": "directoryUser",
        "security": [{ "directoryToken": ["directory"] }],
        "parameters": [{ "$ref": "#/components/parameters/Sub" }],
        "responses": {
          "200": { "description": "The user, with the same shapes as the claims", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DirectoryUser" } } } },
          "401": { "$ref": "#/components/responses/InvalidToken" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/directory/users/{sub}/enrollments": {
      "get": {
        "tags": ["Directory"],
        "summary": "A student's current courses",
        "operationId": "directoryStudentEnrollments",
        "security": [{ "directoryToken": ["directory"] }],
        "parameters": [{ "$ref": "#/components/parameters/Sub" }],
        "responses": {
          "200": { "description": "Offerings the student is enrolled in", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Offering" } } } } },
          "401": { "$ref": "#/components/responses/InvalidToken" },
          "404": { "description": "Unknown user, or not a student", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotFound" } } } }
        }
      }
    },
    "/api/v1/directory/users/{sub}/offerings": {
      "get": {
        "tags": ["Directory"],
        "summary": "The courses a teacher teaches",
        "operationId": "directoryTeacherOfferings",
        "security": [{ "directoryToken": ["directory"] }],
        "parameters": [{ "$ref": "#/components/parameters/Sub" }],
        "responses": {
          "200": { "description": "Offerings", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Offering" } } } } },
          "401": { "$ref": "#/components/responses/InvalidToken" },
          "404": { "description": "Unknown user, or not a teacher", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotFound" } } } }
        }
      }
    },
    "/api/v1/directory/offerings/{id}/students": {
      "get": {
        "tags": ["Directory"],
        "summary": "The students enrolled in a course",
        "operationId": "directoryOfferingStudents",
        "security": [{ "directoryToken": ["directory"] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "description": "The offering id (one course in one semester)", "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "200": { "description": "Enrolled students", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OfferingStudent" } } } } },
          "401": { "$ref": "#/components/responses/InvalidToken" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/directory/faculties/{code}/offerings": {
      "get": {
        "tags": ["Directory"],
        "summary": "A faculty's courses",
        "operationId": "directoryFacultyOfferings",
        "security": [{ "directoryToken": ["directory"] }],
        "parameters": [
          { "$ref": "#/components/parameters/FacultyCode" },
          { "name": "semester", "in": "query", "required": false, "description": "Only this semester, for example `2026-27-W`", "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/Page" }
        ],
        "responses": {
          "200": {
            "description": "At most 200 offerings. When more remain, the `Link` header has `rel=\"next\"`",
            "headers": { "Link": { "$ref": "#/components/headers/NextLink" } },
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OfferingWithTeacher" } } } }
          },
          "401": { "$ref": "#/components/responses/InvalidToken" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/directory/faculties/{code}/students": {
      "get": {
        "tags": ["Directory"],
        "summary": "A faculty's students",
        "operationId": "directoryFacultyStudents",
        "security": [{ "directoryToken": ["directory"] }],
        "parameters": [{ "$ref": "#/components/parameters/FacultyCode" }, { "$ref": "#/components/parameters/Page" }],
        "responses": {
          "200": {
            "description": "At most 200 students. When more remain, the `Link` header has `rel=\"next\"`",
            "headers": { "Link": { "$ref": "#/components/headers/NextLink" } },
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/FacultyStudent" } } } }
          },
          "401": { "$ref": "#/components/responses/InvalidToken" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/staging/roles": {
      "get": {
        "tags": ["Staging tools"],
        "summary": "Every permission and each role's defaults",
        "operationId": "stagingRoles",
        "responses": {
          "200": { "description": "Roles and permissions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagingRoles" } } } }
        }
      }
    },
    "/api/v1/staging/users": {
      "get": {
        "tags": ["Staging tools"],
        "summary": "Every user (never passwords)",
        "operationId": "stagingUsers",
        "responses": {
          "200": { "description": "Users ordered by id", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/StagingUser" } } } } }
        }
      },
      "post": {
        "tags": ["Staging tools"],
        "summary": "Create a test user",
        "description": "The user can sign in at once, with no forced password change.",
        "operationId": "stagingCreateUser",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagingCreateUser" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagingUser" } } } },
          "400": { "$ref": "#/components/responses/ApiError" },
          "409": { "description": "The email or faculty number is taken", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/staging/users/{id}/permissions": {
      "put": {
        "tags": ["Staging tools"],
        "summary": "Replace a user's permissions",
        "description": "Tokens carry the permissions of the moment they are issued, so sign in again afterwards.",
        "operationId": "stagingSetPermissions",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["permissions"], "properties": { "permissions": { "type": "array", "items": { "$ref": "#/components/schemas/Permission" } } } } } }
        },
        "responses": {
          "200": { "description": "The user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagingUser" } } } },
          "400": { "$ref": "#/components/responses/ApiError" },
          "404": { "description": "Unknown user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/v1/staging/sso-clients": {
      "post": {
        "tags": ["Staging tools"],
        "summary": "Register a module",
        "description": "The secret is shown once. Register again under a new id if it is lost.",
        "operationId": "stagingRegisterClient",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientRegistration" } } } },
        "responses": {
          "201": { "description": "Registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientRegistered" } } } },
          "400": { "$ref": "#/components/responses/ApiError" },
          "409": { "description": "The client id is taken", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Operations"],
        "summary": "Liveness and the running commit",
        "description": "Never touches the database. Every response of the portal carries `X-Served-By` with the replica's name.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Up",
            "content": { "application/json": { "schema": { "type": "object", "required": ["status", "version"], "properties": { "status": { "const": "ok" }, "version": { "type": "string", "description": "The git commit" } } } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clientBasic": { "type": "http", "scheme": "basic", "description": "The module's client id and secret" },
      "userAccessToken": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "The `access_token` from an authorization-code exchange" },
      "directoryToken": {
        "type": "oauth2",
        "description": "A client-credentials token with the `directory` scope",
        "flows": { "clientCredentials": { "tokenUrl": "/oauth2/token", "scopes": { "directory": "Read the directory" } } }
      }
    },
    "parameters": {
      "Sub": { "name": "sub", "in": "path", "required": true, "description": "The portal's user id (the `sub` claim)", "schema": { "type": "string", "examples": ["4"] } },
      "FacultyCode": { "name": "code", "in": "path", "required": true, "description": "The faculty code", "schema": { "type": "string", "examples": ["FCST"] } },
      "Page": { "name": "page", "in": "query", "required": false, "description": "Page number, from 1", "schema": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1 } }
    },
    "headers": {
      "NextLink": { "description": "`<...?page=N>; rel=\"next\"` when more items remain", "schema": { "type": "string" } }
    },
    "responses": {
      "InvalidToken": {
        "description": "Missing, invalid, expired or revoked token, or the wrong kind of token",
        "content": { "application/json": { "schema": { "type": "object", "required": ["error"], "properties": { "error": { "const": "invalid_token" } } } } }
      },
      "NotFound": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotFound" } } } },
      "ApiError": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
    },
    "schemas": {
      "Role": { "type": "string", "description": "Today one of these. More may come: treat an unknown role as no access", "examples": ["STUDENT"], "enum": ["STUDENT", "TEACHER", "DEAN", "INSPECTOR", "ADMIN"] },
      "Permission": {
        "type": "string",
        "description": "Lists are in this (bit) order. More may come",
        "enum": ["STAFF_CREATE", "STUDENT_CREATE", "STUDENT_PROFILE_READ_OWN", "STUDENT_PROFILE_READ_ANY", "STUDENT_PROFILE_READ_ENROLLED", "COURSE_CREATE_MODIFY", "COURSE_OFFERING_READ", "COURSE_OFFERING_CREATE_MODIFY", "ENROLLMENT_REQUEST_CREATE", "ENROLLMENT_REQUEST_ACCEPT_REJECT", "STUDENT_PROFILE_READ_FACULTY"]
      },
      "Faculty": { "type": "object", "required": ["code", "name"], "properties": { "code": { "type": "string", "examples": ["FCST"] }, "name": { "type": "string", "examples": ["Факултет по компютърни системи и технологии"] } } },
      "Student": {
        "type": "object",
        "required": ["faculty_number", "specialty", "study_year", "status"],
        "properties": {
          "faculty_number": { "type": "string", "examples": ["121219001"] },
          "specialty": { "type": "string", "examples": ["Компютърни науки"] },
          "study_year": { "type": "integer", "minimum": 1, "maximum": 6 },
          "status": { "type": "string", "enum": ["ACTIVE", "INTERRUPTED", "GRADUATED"] }
        }
      },
      "Claims": {
        "type": "object",
        "description": "Each group comes only with its scope: `email`; `profile` (`given_name`, `family_name`, `name`); `unicloud` (`role`, `permissions`, `faculty`, `student`)",
        "required": ["sub"],
        "properties": {
          "sub": { "type": "string", "description": "The user id. Stable: use it as the key, not the email", "examples": ["4"] },
          "email": { "type": "string", "format": "email" },
          "given_name": { "type": "string" },
          "family_name": { "type": "string" },
          "name": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" },
          "permissions": { "type": "array", "items": { "$ref": "#/components/schemas/Permission" } },
          "faculty": { "$ref": "#/components/schemas/Faculty" },
          "student": { "$ref": "#/components/schemas/Student" }
        }
      },
      "DirectoryUser": {
        "type": "object",
        "required": ["sub", "role", "email", "given_name", "family_name", "name"],
        "properties": {
          "sub": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" },
          "email": { "type": "string", "format": "email" },
          "given_name": { "type": "string" },
          "family_name": { "type": "string" },
          "name": { "type": "string" },
          "faculty": { "$ref": "#/components/schemas/Faculty" },
          "student": { "$ref": "#/components/schemas/Student" }
        }
      },
      "Offering": {
        "type": "object",
        "description": "One course in one semester. `code` is the course code, the identifier to share with other modules",
        "required": ["id", "code", "title", "semester"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "code": { "type": "string", "examples": ["MATH1"] },
          "title": { "type": "string" },
          "semester": { "type": "string", "examples": ["2026-27-W"] }
        }
      },
      "OfferingWithTeacher": {
        "allOf": [{ "$ref": "#/components/schemas/Offering" }, { "type": "object", "required": ["teacher_sub"], "properties": { "teacher_sub": { "type": "string" } } }]
      },
      "OfferingStudent": {
        "type": "object",
        "required": ["sub", "name", "faculty_number"],
        "properties": { "sub": { "type": "string" }, "name": { "type": "string" }, "faculty_number": { "type": "string" } }
      },
      "FacultyStudent": {
        "type": "object",
        "required": ["sub", "name", "faculty_number", "specialty", "study_year", "status"],
        "properties": {
          "sub": { "type": "string" },
          "name": { "type": "string" },
          "faculty_number": { "type": "string" },
          "specialty": { "type": "string" },
          "study_year": { "type": "integer" },
          "status": { "type": "string", "enum": ["ACTIVE", "INTERRUPTED", "GRADUATED"] }
        }
      },
      "NotFound": { "type": "object", "required": ["error"], "properties": { "error": { "const": "not_found" } } },
      "AuthorizationCodeGrant": {
        "type": "object",
        "required": ["grant_type", "code", "redirect_uri", "code_verifier"],
        "properties": {
          "grant_type": { "const": "authorization_code" },
          "code": { "type": "string", "description": "From the callback" },
          "redirect_uri": { "type": "string", "description": "The same as in the login" },
          "code_verifier": { "type": "string", "description": "The PKCE verifier, 43 to 128 characters" }
        }
      },
      "ClientCredentialsGrant": {
        "type": "object",
        "required": ["grant_type"],
        "properties": { "grant_type": { "const": "client_credentials" }, "scope": { "const": "directory" } }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["access_token", "scope", "token_type", "expires_in"],
        "properties": {
          "access_token": { "type": "string", "description": "JWT, header `typ: at+jwt`" },
          "id_token": { "type": "string", "description": "JWT. Only for `authorization_code`" },
          "scope": { "type": "string", "examples": ["openid profile email unicloud"] },
          "token_type": { "const": "Bearer" },
          "expires_in": { "type": "integer", "examples": [1800] }
        }
      },
      "OAuthError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "enum": ["invalid_request", "invalid_client", "invalid_grant", "invalid_scope", "unsupported_grant_type", "server_error"] },
          "error_description": { "type": "string" }
        }
      },
      "Discovery": {
        "type": "object",
        "required": ["issuer", "authorization_endpoint", "token_endpoint", "jwks_uri", "userinfo_endpoint", "end_session_endpoint"],
        "properties": {
          "issuer": { "type": "string" },
          "authorization_endpoint": { "type": "string" },
          "token_endpoint": { "type": "string" },
          "jwks_uri": { "type": "string" },
          "userinfo_endpoint": { "type": "string" },
          "end_session_endpoint": { "type": "string" },
          "response_types_supported": { "type": "array", "items": { "type": "string" } },
          "grant_types_supported": { "type": "array", "items": { "type": "string" } },
          "code_challenge_methods_supported": { "type": "array", "items": { "type": "string" } },
          "scopes_supported": { "type": "array", "items": { "type": "string" } },
          "token_endpoint_auth_methods_supported": { "type": "array", "items": { "type": "string" } },
          "id_token_signing_alg_values_supported": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Jwks": {
        "type": "object",
        "required": ["keys"],
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kty", "kid", "n", "e"],
              "properties": { "kty": { "const": "RSA" }, "kid": { "type": "string", "description": "RFC 7638 thumbprint" }, "n": { "type": "string" }, "e": { "type": "string" } }
            }
          }
        }
      },
      "StagingRoles": {
        "type": "object",
        "required": ["roleDefaults", "permissions"],
        "properties": {
          "roleDefaults": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/components/schemas/Permission" } } },
          "permissions": { "type": "array", "items": { "$ref": "#/components/schemas/Permission" } }
        }
      },
      "StagingUser": {
        "type": "object",
        "required": ["id", "email", "firstName", "lastName", "role", "permissions", "student"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "email": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" },
          "faculty": { "type": ["string", "null"], "description": "Faculty code" },
          "permissions": { "type": "array", "items": { "$ref": "#/components/schemas/Permission" } },
          "student": { "type": "boolean", "description": "Has an academic record" }
        }
      },
      "StagingCreateUser": {
        "type": "object",
        "required": ["email", "password", "firstName", "lastName", "role"],
        "properties": {
          "email": { "type": "string", "maxLength": 254 },
          "password": { "type": "string", "minLength": 8, "maxLength": 72 },
          "firstName": { "type": "string", "maxLength": 100 },
          "lastName": { "type": "string", "maxLength": 100 },
          "role": { "type": "string", "description": "Case-insensitive", "examples": ["TEACHER"] },
          "faculty": { "type": "string", "description": "Faculty code. Required for TEACHER, DEAN and INSPECTOR", "examples": ["FCST"] },
          "permissions": { "type": "array", "description": "Left out: the role's defaults. `[]`: none", "items": { "$ref": "#/components/schemas/Permission" } },
          "student": {
            "type": "object",
            "description": "Required for STUDENT, refused for other roles",
            "required": ["facultyNumber", "specialty", "studyYear"],
            "properties": {
              "facultyNumber": { "type": "string", "maxLength": 20 },
              "specialty": { "type": "string", "description": "A specialty name or id", "examples": ["Компютърни науки"] },
              "studyYear": { "type": "integer", "minimum": 1, "maximum": 6 },
              "status": { "type": "string", "enum": ["ACTIVE", "INTERRUPTED", "GRADUATED"], "default": "ACTIVE" }
            }
          }
        }
      },
      "ClientRegistration": {
        "type": "object",
        "required": ["clientId", "name", "redirectUris"],
        "properties": {
          "clientId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "description": "`unicloud-*` and all-digit ids are reserved", "examples": ["module-x"] },
          "name": { "type": "string", "maxLength": 200 },
          "redirectUris": { "type": "array", "minItems": 1, "items": { "type": "string" }, "examples": [["http://localhost:3000/auth/callback"]] },
          "postLogoutRedirectUris": { "type": "array", "items": { "type": "string" } },
          "directory": { "type": "boolean", "default": false, "description": "Grant the directory API" }
        }
      },
      "ClientRegistered": {
        "type": "object",
        "required": ["clientId", "clientSecret", "redirectUris", "postLogoutRedirectUris", "directory"],
        "properties": {
          "clientId": { "type": "string" },
          "clientSecret": { "type": "string", "description": "43 characters. Shown once" },
          "redirectUris": { "type": "array", "items": { "type": "string" } },
          "postLogoutRedirectUris": { "type": "array", "items": { "type": "string" } },
          "directory": { "type": "boolean" }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["timestamp", "status", "error", "message", "path"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "status": { "type": "integer" },
          "error": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "fieldErrors": { "type": ["array", "null"], "items": { "type": "object", "properties": { "field": { "type": "string" }, "message": { "type": "string" } } } }
        }
      }
    }
  }
}
